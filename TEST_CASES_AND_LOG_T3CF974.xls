   </Row>
   <Row>
    <Cell ss:StyleID="sDataCenter"><Data ss:Type="String">TC_RES_05</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đặt trước sách</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đúng (Happy Path)</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Độc giả huỷ đơn đặt trước -&gt; Status=&#x27;CANCELLED&#x27;, bản sao trả về &#x27;AVAILABLE&#x27;</Data></Cell>
