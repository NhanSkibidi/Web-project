   <Row>
    <Cell ss:StyleID="sDataCenter"><Data ss:Type="String">TC_RES_02</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đặt trước sách</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đúng (Happy Path)</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Xếp hàng FIFO: Độc giả 2 vào hàng chờ sau Độc giả 1 (Vị trí #2)</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">queue_position=2</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">queue_position=2</Data></Cell>
    <Cell ss:StyleID="sPass"><Data ss:Type="String">PASS</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">None</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đã nghiệm thu</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sDataCenter"><Data ss:Type="String">TC_RES_03</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đặt trước sách</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đúng (Happy Path)</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Trả sách -&gt; Đơn vị trí #1 chuyển READY, bản sao đổi RESERVED, giữ 2 ngày</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">status=&#x27;READY&#x27;, copy=&#x27;RESERVED&#x27;, deadline=+48h</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">status=&#x27;READY&#x27;, copy=&#x27;RESERVED&#x27;, deadline=2026-11-24 15:03:10.895098</Data></Cell>
    <Cell ss:StyleID="sPass"><Data ss:Type="String">PASS</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Enum BORROWED-&gt;RESERVED trước đây bị thiếu</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đã sửa &amp; Verified</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sDataCenter"><Data ss:Type="String">TC_RES_04</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đặt trước sách</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đúng (Happy Path)</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Quá hạn 2 ngày -&gt; Đơn #1 chuyển EXPIRED, Độc giả 2 tự động được nhường thành READY</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">res1=&#x27;EXPIRED&#x27;, res2=&#x27;READY&#x27;</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">res1=&#x27;EXPIRED&#x27;, res2=&#x27;READY&#x27;</Data></Cell>
    <Cell ss:StyleID="sPass"><Data ss:Type="String">PASS</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">None</Data></Cell>
