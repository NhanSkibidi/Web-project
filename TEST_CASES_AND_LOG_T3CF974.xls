   </Row>
   <Row>
    <Cell ss:StyleID="sDataCenter"><Data ss:Type="String">TC_TAX_01</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Quản lý Danh mục</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đúng (Happy Path)</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Thêm mới thành công Thể loại, Tác giả, NXB với dữ liệu hợp lệ</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">HTTP 201 / Bản ghi được lưu vào CSDL</Data></Cell>
