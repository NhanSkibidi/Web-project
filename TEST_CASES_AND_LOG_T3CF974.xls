<?xml version="1.0" encoding="UTF-8"?>
<?mso-application progid="Excel.Sheet"?>
<Workbook xmlns="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:o="urn:schemas-microsoft-com:office:office"
 xmlns:x="urn:schemas-microsoft-com:office:excel"
 xmlns:ss="urn:schemas-microsoft-com:office:spreadsheet"
 xmlns:html="http://www.w3.org/TR/REC-html40">
 <Styles>
  <Style ss:ID="Default" ss:Name="Normal">
   <Alignment ss:Vertical="Center"/>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Color="#1C1917"/>
  </Style>
  <Style ss:ID="HeaderStyle">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center" ss:WrapText="1"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="2" ss:Color="#15803D"/>
    <Border ss:Position="Left" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Top" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
   <Font ss:FontName="Segoe UI" ss:Size="10.5" ss:Color="#FFFFFF" ss:Bold="1"/>
   <Interior ss:Color="#1B4332" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="IDStyle">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Font ss:FontName="Consolas" ss:Size="10" ss:Bold="1" ss:Color="#1E293B"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
  </Style>
  <Style ss:ID="TitleStyle">
   <Alignment ss:Vertical="Center" ss:WrapText="1"/>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Bold="1" ss:Color="#0F172A"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
  </Style>
  <Style ss:ID="TextStyle">
   <Alignment ss:Vertical="Center" ss:WrapText="1"/>
   <Font ss:FontName="Segoe UI" ss:Size="9.5" ss:Color="#334155"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
  </Style>
  <Style ss:ID="CodeStyle">
   <Alignment ss:Vertical="Center" ss:WrapText="1"/>
   <Font ss:FontName="Consolas" ss:Size="9" ss:Color="#475569"/>
   <Interior ss:Color="#F8FAFC" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
  </Style>
  <Style ss:ID="TypeStyle">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Font ss:FontName="Segoe UI" ss:Size="9.5" ss:Bold="1" ss:Color="#0369A1"/>
   <Interior ss:Color="#F0F9FF" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
  </Style>
  <Style ss:ID="PassStyle">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Bold="1" ss:Color="#15803D"/>
   <Interior ss:Color="#DCFCE7" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#86EFAC"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#86EFAC"/>
   </Borders>
  </Style>
  <Style ss:ID="FailStyle">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Font ss:FontName="Segoe UI" ss:Size="10" ss:Bold="1" ss:Color="#DC2626"/>
   <Interior ss:Color="#FEE2E2" ss:Pattern="Solid"/>
  </Style>
  <Style ss:ID="BugStyle">
   <Alignment ss:Vertical="Center" ss:WrapText="1"/>
   <Font ss:FontName="Segoe UI" ss:Size="9" ss:Color="#B91C1C"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#E2E8F0"/>
   </Borders>
  </Style>
  <Style ss:ID="VerifiedStyle">
   <Alignment ss:Horizontal="Center" ss:Vertical="Center"/>
   <Font ss:FontName="Segoe UI" ss:Size="9.5" ss:Bold="1" ss:Color="#1E40AF"/>
   <Interior ss:Color="#DBEAFE" ss:Pattern="Solid"/>
   <Borders>
    <Border ss:Position="Bottom" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#93C5FD"/>
    <Border ss:Position="Right" ss:LineStyle="Continuous" ss:Weight="1" ss:Color="#93C5FD"/>
   </Borders>
  </Style>
 </Styles>
 <Worksheet ss:Name="Test Cases &amp; Test Log">
  <Table ss:ExpandedColumnCount="12" x:FullColumns="1" x:FullRows="1" ss:DefaultRowHeight="20">
   <Column ss:Width="85"/>
   <Column ss:Width="150"/>
   <Column ss:Width="130"/>
   <Column ss:Width="240"/>
   <Column ss:Width="200"/>
   <Column ss:Width="240"/>
   <Column ss:Width="180"/>
   <Column ss:Width="250"/>
   <Column ss:Width="240"/>
   <Column ss:Width="80"/>
   <Column ss:Width="180"/>
   <Column ss:Width="130"/>
   <Row ss:Height="28"><Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Mã Test Case</Data></Cell><Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Module / Chức năng</Data></Cell><Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Phân loại</Data></Cell><Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Tiêu đề kịch bản</Data></Cell><Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Điều kiện tiên quyết</Data></Cell><Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Các bước thực hiện</Data></Cell><Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Dữ liệu kiểm thử</Data></Cell><Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Kết quả mong đợi</Data></Cell><Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Kết quả thực tế</Data></Cell><Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Trạng thái</Data></Cell><Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Bug phát hiện</Data></Cell><Cell ss:StyleID="HeaderStyle"><Data ss:Type="String">Tình trạng xử lý</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_RES_01</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Đặt trước sách (T3CFCAC)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Đúng (Happy Path)</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Độc giả đặt trước thành công khi đầu sách đã hết sạch bản sao khả dụng</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Tài khoản Độc giả đã đăng nhập (READER), đầu sách ISBN &#x27;978-0132350884&#x27; có số bản sao AVAILABLE = 0.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Mở trang chi tiết sách book_detail.html?isbn=978-0132350884
2. Thấy nút &#x27;Đặt trước tài liệu&#x27; (thay vì nút Mượn sách)
3. Nhấn nút &#x27;Đặt trước tài liệu&#x27;
4. Xác nhận yêu cầu đặt trước</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">user_id=1, book_isbn=&#x27;978-0132350884&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">HTTP 201 Created. Tạo bản ghi Reservation thành công, status=&#x27;WAITING&#x27;, vị trí hàng chờ queue_position=#1. Toast thông báo &#x27;Đặt trước thành công&#x27;.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Tạo bản ghi ID #1 thành công, status=&#x27;WAITING&#x27;, queue_position=#1. Toast hiển thị đúng thông điệp.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">None</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã nghiệm thu</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_RES_02</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Đặt trước sách (T3CFCAC)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Đúng (Happy Path)</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Xếp hàng nhiều người theo thứ tự thời gian (FIFO: First In First Out)</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Reader 1 đã đặt vị trí #1. Reader 2 đăng nhập và cùng đặt đầu sách đó.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Đăng nhập tài khoản Reader 2
2. Mở trang chi tiết sách và bấm &#x27;Đặt trước tài liệu&#x27;</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">user_id=2, book_isbn=&#x27;978-0132350884&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">HTTP 201 Created. Reader 2 vào vị trí hàng chờ queue_position=#2. Vị trí Reader 1 giữ nguyên #1.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Reader 2 nhận đơn ID #2, queue_position=#2. Thứ tự FIFO bảo đảm chính xác.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">None</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã nghiệm thu</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_RES_03</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Đặt trước sách (T3CFCAC)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Sai dữ liệu</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Chặn đặt trước khi đầu sách VẪN CÒN bản sao khả dụng tại thư viện</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Đầu sách ISBN &#x27;978-6042100001&#x27; hiện còn 2 bản sao AVAILABLE.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Độc giả gửi request POST /api/reservations với ISBN sách còn sẵn</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">book_isbn=&#x27;978-6042100001&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">HTTP 400 Bad Request. Báo lỗi rõ: &#x27;Đầu sách hiện vẫn còn bản sao khả dụng. Bạn có thể mượn trực tiếp mà không cần đặt trước.&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Trả về HTTP 400 với thông báo chi tiết ngăn đặt trước khi sách chưa hết.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">None</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã nghiệm thu</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_RES_04</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Đặt trước sách (T3CFCAC)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Sai dữ liệu</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Chặn độc giả đặt trước trùng lặp cùng một đầu sách</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Reader 1 đã có đơn đặt trước đang hiệu lực (WAITING) cho sách ISBN &#x27;978-0132350884&#x27;.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Reader 1 bấm đặt trước tiếp lần thứ 2 cuốn sách đó</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">user_id=1, book_isbn=&#x27;978-0132350884&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">HTTP 400 Bad Request. Báo lỗi: &#x27;Bạn đã có một yêu cầu đặt trước đang hiệu lực cho cuốn sách này.&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">HTTP 400 trả về chính xác, không phát sinh đơn trùng lặp.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">None</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã nghiệm thu</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_RES_05</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Đặt trước sách (T3CFCAC)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Sai dữ liệu</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Chặn độc giả vượt quá giới hạn tối đa 3 đơn đặt trước đang hiệu lực</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Reader 1 đã có 3 đơn đặt trước ở trạng thái WAITING/READY.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Reader 1 thử đặt thêm cuốn sách thứ 4</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">user_id=1, book_isbn_4=&#x27;978-0321356680&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">HTTP 400 Bad Request. Thông báo: &#x27;Mỗi độc giả chỉ được đặt trước tối đa 3 đầu sách cùng lúc. Vui lòng huỷ hoặc hoàn thành các lượt trước đó.&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Hệ thống chặn thành công, giữ đúng quota 3 cuốn/người.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">None</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã nghiệm thu</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_RES_06</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Đặt trước sách (T3CFCAC)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Đúng (Happy Path)</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Khi có bản sao được trả -&gt; Người đầu hàng chuyển READY, bản sao sang RESERVED, giữ 2 ngày</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Reader 1 ở vị trí #1 WAITING. Độc giả khác mang cuốn sách đó tới thư viện trả.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Thủ thư thực hiện thao tác trả sách tại quầy
2. Hệ thống gọi hook process_returned_copy_for_reservation()</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">copy_id=1, book_isbn=&#x27;978-0132350884&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Đơn của Reader 1 đổi sang status=&#x27;READY&#x27;, gán copy_id=1, hạn pickup_deadline = now + 48h (2 ngày). Bản sao BookCopy.status chuyển thành &#x27;RESERVED&#x27;.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Reader 1 chuyển status=&#x27;READY&#x27;, pickup_deadline chính xác sau 2 ngày, copy đổi sang RESERVED.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">Bug trước đây: Enum transition BORROWED -&gt; RESERVED bị chặn</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã sửa &amp; Verified</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_RES_07</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Đặt trước sách (T3CFCAC)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Đúng (Happy Path)</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Hết hạn lấy sách 2 ngày -&gt; Tự động chuyển đơn sang EXPIRED, nhường lượt cho người tiếp theo</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Reader 1 có đơn READY nhưng quá 48h không tới lấy. Reader 2 đang WAITING ở vị trí #2.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Hệ thống chạy quét hạn check_and_expire_reservations()
2. Xử lý chuyển lượt</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">pickup_deadline &lt; now()</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Đơn Reader 1 chuyển sang &#x27;EXPIRED&#x27;. Đơn Reader 2 lập tức chuyển thành &#x27;READY&#x27; và nhận cuốn sách đó với deadline 2 ngày mới.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Reader 1 đổi thành EXPIRED, Reader 2 được nâng lên READY với deadline mới.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">None</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã nghiệm thu</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_RES_08</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Đặt trước sách (T3CFCAC)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Đúng (Happy Path)</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Độc giả chủ động huỷ đơn đặt trước</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Reader 1 có đơn đặt trước ở trạng thái WAITING hoặc READY.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Vào trang Sách đặt trước (reservations.html)
2. Bấm &#x27;Huỷ đặt trước&#x27; trên thẻ sách
3. Hộp thoại modal hiện ra xác nhận
4. Bấm &#x27;Đồng ý huỷ&#x27;</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">POST /api/reservations/{id}/cancel</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Đơn chuyển sang status=&#x27;CANCELLED&#x27;. Nếu đang giữ bản sao và không còn ai chờ thì bản sao trả về AVAILABLE. Hàng chờ phía sau tự dồn lên.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Đơn huỷ thành công, bản sao cập nhật AVAILABLE, danh sách cập nhật ngay lập tức.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">None</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã nghiệm thu</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_RES_09</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Đặt trước sách (T3CFCAC)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Chưa đăng nhập</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Chặn người dùng chưa đăng nhập gọi API đặt trước hoặc xem danh sách đặt</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Client không gửi kèm Authorization Header (Bearer Token).</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Gửi request POST /api/reservations không kèm token
2. Gửi request GET /api/reservations/my không kèm token</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">Header: Authorization=None</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">HTTP 401 Unauthorized. Thông báo: &#x27;Yêu cầu đăng nhập để thực hiện thao tác này.&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Trả về HTTP 401 Unauthorized chính xác.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">None</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã nghiệm thu</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_RES_10</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Đặt trước sách (T3CFCAC)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Sai quyền</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Độc giả không được phép truy cập API dành riêng cho Thủ thư (Staff Ready List / Fulfill)</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Đăng nhập tài khoản có role=&#x27;READER&#x27;.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Dùng token READER gọi GET /api/reservations/staff/ready
2. Gọi POST /api/reservations/{id}/fulfill</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">Token role: READER</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">HTTP 403 Forbidden. Từ chối truy cập vì chỉ có LIBRARIAN hoặc ADMIN mới có quyền duyệt nhận sách tại quầy.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Trả về HTTP 403 Forbidden, bảo đảm an toàn phân quyền.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">None</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã nghiệm thu</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_RES_11</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Đặt trước sách (T3CFCAC)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Sai dữ liệu</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Gửi mã ISBN không tồn tại trong hệ thống</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Mã ISBN &#x27;999-9999999999&#x27; không có trong bảng books.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Gửi POST /api/reservations với book_isbn không tồn tại</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">book_isbn=&#x27;999-9999999999&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">HTTP 404 Not Found. Báo lỗi: &#x27;Không tìm thấy đầu sách với mã ISBN yêu cầu.&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Trả về HTTP 404 Not Found rõ ràng.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">None</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã nghiệm thu</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_TAX_01</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Quản lý Thể loại (T3CFCC6)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Đúng (Happy Path)</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Thêm mới thể loại sách thành công với dữ liệu hợp lệ</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Đăng nhập quyền LIBRARIAN hoặc ADMIN. Tên thể loại chưa từng có trong hệ thống.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Mở trang taxonomy.html, chọn tab &#x27;Thể loại sách&#x27;
2. Bấm nút &#x27;Thêm thể loại mới&#x27;
3. Điền Tên: &#x27;Trí Tuệ Nhân Tạo&#x27;, Mô tả: &#x27;Tài liệu về AI &amp; Machine Learning&#x27;
4. Bấm &#x27;Lưu dữ liệu&#x27;</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">name=&#x27;Trí Tuệ Nhân Tạo&#x27;, description=&#x27;Tài liệu về AI &amp; Machine Learning&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">HTTP 201 Created. Thể loại được lưu vào CSDL, bảng cập nhật thêm dòng mới, toast xanh thông báo thành công.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Thêm thành công ID mới, dữ liệu hiển thị ngay lập tức trên bảng.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">None</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã nghiệm thu</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_TAX_02</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Quản lý Thể loại (T3CFCC6)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Sai dữ liệu</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Chặn thêm thể loại có tên trùng lặp (không phân biệt hoa/thường)</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Đã có thể loại &#x27;Trí Tuệ Nhân Tạo&#x27; trong CSDL.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Bấm &#x27;Thêm thể loại mới&#x27;
2. Nhập tên: &#x27;trí tuệ nhân tạo&#x27; (chữ thường)
3. Bấm &#x27;Lưu dữ liệu&#x27;</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">name=&#x27;trí tuệ nhân tạo&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">HTTP 400 Bad Request. Báo lỗi: &#x27;Thể loại &#x27;trí tuệ nhân tạo&#x27; đã tồn tại trong hệ thống. Vui lòng chọn tên khác.&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Hệ thống chặn và hiển thị toast đỏ báo lỗi trùng lặp rõ ràng.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">None</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã nghiệm thu</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_TAX_03</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Quản lý Thể loại (T3CFCC6)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Sai dữ liệu</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Chặn cập nhật đổi tên thể loại trùng với tên của một thể loại khác</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Có 2 thể loại: ID #1 &#x27;Công nghệ thông tin&#x27; và ID #2 &#x27;Kinh tế học&#x27;.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Bấm nút Sửa ở thể loại ID #1
2. Đổi tên thành &#x27;Kinh tế học&#x27;
3. Bấm &#x27;Cập nhật thay đổi&#x27;</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">id=1, name=&#x27;Kinh tế học&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">HTTP 400 Bad Request. Báo lỗi: &#x27;Tên thể loại &#x27;Kinh tế học&#x27; đã tồn tại ở bản ghi khác. Vui lòng chọn tên khác.&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Chặn thành công với HTTP 400 và giữ nguyên dữ liệu cũ.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">None</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã nghiệm thu</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_TAX_04</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Quản lý Thể loại (T3CFCC6)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Đúng (Happy Path)</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Tìm kiếm thể loại theo từ khoá và phân trang</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Có 15 thể loại sách trong CSDL.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Nhập từ khoá &#x27;kinh tế&#x27; vào ô tìm kiếm
2. Kiểm tra danh sách lọc
3. Chuyển đổi giữa các trang (Trang 1, Trang 2)</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">search=&#x27;kinh tế&#x27;, page=1, page_size=10</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Hiển thị đúng các thể loại chứa từ khoá &#x27;kinh tế&#x27;. Phân trang tính toán đúng total, total_pages, nút Prev/Next hoạt động mượt.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Bộ lọc debounce 350ms hoạt động nhanh nhạy, phân trang chính xác.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">None</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã nghiệm thu</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_TAX_05</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Quản lý Thể loại (T3CFCC6)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Sai dữ liệu</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">CHẶN XOÁ THỂ LOẠI KHI CÒN ĐẦU SÁCH LIÊN KẾT (Yêu cầu cốt lõi bài toán)</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Thể loại &#x27;Khoa Học Máy Tính&#x27; đang có 3 đầu sách thuộc thể loại này.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Bấm nút Xoá (thùng rác) tại dòng thể loại &#x27;Khoa Học Máy Tính&#x27;
2. Quan sát hộp thoại xác nhận xoá</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">category_id=1, linked_books_count=3</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Hộp thoại hiển thị cảnh báo đỏ nổi bật: &#x27;Mục này hiện đang có 3 đầu sách liên kết trực tiếp trong kho. Không được phép xoá!&#x27;. Nút xoá bị disable. Nếu gọi API DELETE -&gt; HTTP 400: &#x27;Không thể xoá thể loại vì vẫn còn 3 đầu sách liên kết.&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Modal chặn nút xoá, backend trả về HTTP 400 kèm số lượng sách chính xác.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">None</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã nghiệm thu</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_TAX_06</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Quản lý Thể loại (T3CFCC6)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Đúng (Happy Path)</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Xoá thành công thể loại khi KHÔNG CÒN đầu sách liên kết</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Thể loại &#x27;Sách Mới Thử Nghiệm&#x27; có 0 đầu sách liên kết.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Bấm nút Xoá tại dòng thể loại
2. Hộp thoại mở ra, nút &#x27;Xoá vĩnh viễn&#x27; cho phép bấm
3. Nhấn &#x27;Xoá vĩnh viễn&#x27;</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">category_id=99, linked_books_count=0</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">HTTP 200 OK. Bản ghi được xoá hoàn toàn khỏi CSDL. Bảng tự động tải lại, toast thông báo &#x27;Đã xoá thành công&#x27;.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Xoá thành công, bản ghi biến mất khỏi bảng ngay tức thì.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">None</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã nghiệm thu</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_TAX_07</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Quản lý Tác giả (T3CFCC6)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Đúng (Happy Path)</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Thêm mới tác giả và kiểm tra chặn trùng lặp</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Đăng nhập quyền LIBRARIAN.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Chọn tab &#x27;Tác giả&#x27;
2. Bấm &#x27;Thêm tác giả mới&#x27;
3. Điền Tên: &#x27;Robert C. Martin&#x27;, Quốc tịch: &#x27;USA&#x27;
4. Thử thêm lại tác giả tên tương tự</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">name=&#x27;Robert C. Martin&#x27;, nationality=&#x27;USA&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Lần 1: Thành công HTTP 201. Lần 2: Chặn lại HTTP 400 với thông báo &#x27;Tác giả đã tồn tại trong hệ thống.&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Tạo mới thành công lần 1, chặn trùng tên chính xác lần 2.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">None</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã nghiệm thu</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_TAX_08</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Quản lý Tác giả (T3CFCC6)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Sai dữ liệu</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">CHẶN XOÁ TÁC GIẢ KHI CÒN ĐẦU SÁCH LIÊN KẾT</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Tác giả &#x27;Robert C. Martin&#x27; đang liên kết với sách &#x27;Clean Code&#x27;.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Chọn tab &#x27;Tác giả&#x27;
2. Bấm nút Xoá tác giả &#x27;Robert C. Martin&#x27;</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">author_id=1, linked_books=1</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">HTTP 400 Bad Request. Báo lỗi: &#x27;Không thể xoá tác giả &#x27;Robert C. Martin&#x27; vì vẫn còn 1 đầu sách liên kết tác giả này đứng tên.&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Chặn xoá thành công trên cả giao diện Modal và Backend API.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">None</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã nghiệm thu</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_TAX_09</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Quản lý Nhà xuất bản (T3CFCC6)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Đúng (Happy Path)</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Thêm mới và cập nhật thông tin Nhà xuất bản</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Đăng nhập quyền LIBRARIAN.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Chọn tab &#x27;Nhà xuất bản&#x27;
2. Bấm &#x27;Thêm nhà xuất bản mới&#x27;
3. Nhập Tên: &#x27;NXB Giáo Dục Việt Nam&#x27;, Địa chỉ: &#x27;Hà Nội&#x27;
4. Bấm Lưu -&gt; Sau đó bấm nút Sửa cập nhật địa chỉ</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">name=&#x27;NXB Giáo Dục Việt Nam&#x27;, address=&#x27;Hà Nội&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Tạo mới thành công HTTP 201. Cập nhật thành công HTTP 200, hiển thị badge số lượng sách liên kết.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Cả thêm mới và sửa hoạt động hoàn hảo.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">None</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã nghiệm thu</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_TAX_10</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Quản lý Nhà xuất bản (T3CFCC6)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Sai dữ liệu</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">CHẶN XOÁ NHÀ XUẤT BẢN KHI CÒN ĐẦU SÁCH LIÊN KẾT</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">NXB &#x27;NXB Thông Tin &amp; Truyền Thông&#x27; đang có 2 đầu sách xuất bản.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Gửi request DELETE /api/publishers/{id}</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">publisher_id=1, linked_books=2</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">HTTP 400 Bad Request. Báo lỗi: &#x27;Không thể xoá nhà xuất bản vì vẫn còn 2 đầu sách thuộc NXB này.&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">HTTP 400 trả về thông báo chi tiết, không cho phép xoá.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">None</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã nghiệm thu</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_TAX_11</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Quản lý Danh mục (T3CFCC6)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Chưa đăng nhập</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Chặn người dùng chưa đăng nhập thực hiện thao tác thêm/sửa/xoá danh mục</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Không truyền token xác thực.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Gọi POST /api/categories không có token
2. Gọi DELETE /api/authors/1 không có token</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">Header Authorization=None</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Từ chối thực hiện hoặc yêu cầu đăng nhập đối với các thao tác quản trị.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Frontend điều hướng trang login hoặc backend chặn thao tác trái phép.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">None</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã nghiệm thu</Data></Cell></Row><Row ss:Height="48"><Cell ss:StyleID="IDStyle"><Data ss:Type="String">TC_TAX_12</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Quản lý Danh mục (T3CFCC6)</Data></Cell><Cell ss:StyleID="TypeStyle"><Data ss:Type="String">Sai dữ liệu</Data></Cell><Cell ss:StyleID="TitleStyle"><Data ss:Type="String">Xử lý khi nhập tên để trống hoặc toàn dấu cách trắng</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Mở Form thêm mới bất kỳ tab nào.</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">1. Nhập trường Tên: &#x27;    &#x27; (chỉ có khoảng trắng)
2. Bấm Lưu dữ liệu</Data></Cell><Cell ss:StyleID="CodeStyle"><Data ss:Type="String">name=&#x27;   &#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Chặn ngay tại Frontend (HTML5 validation required) và Backend kiểm tra .strip() rỗng trả về HTTP 400: &#x27;Tên không được để trống.&#x27;</Data></Cell><Cell ss:StyleID="TextStyle"><Data ss:Type="String">Chặn thành công cả ở client và server.</Data></Cell><Cell ss:StyleID="PassStyle"><Data ss:Type="String">PASS</Data></Cell><Cell ss:StyleID="BugStyle"><Data ss:Type="String">None</Data></Cell><Cell ss:StyleID="VerifiedStyle"><Data ss:Type="String">Đã nghiệm thu</Data></Cell></Row>
  </Table>
 </Worksheet>
</Workbook>
