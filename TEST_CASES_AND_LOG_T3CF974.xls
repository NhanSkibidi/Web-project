   <Row>
    <Cell ss:StyleID="sDataCenter"><Data ss:Type="String">TC_TAX_03</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Quản lý Danh mục</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đúng (Happy Path)</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Xoá thành công Thể loại, Tác giả, NXB khi không có đầu sách nào liên kết</Data></Cell>
