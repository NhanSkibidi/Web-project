   <Row>
    <Cell ss:StyleID="sDataCenter"><Data ss:Type="String">TC_RES_06</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đặt trước sách</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Sai dữ liệu</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Chặn đặt trước khi đầu sách vẫn còn bản sao khả dụng (Available &gt; 0)</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">HTTP 400: &#x27;Đầu sách hiện vẫn còn bản sao khả dụng&#x27;</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">HTTP 400: Đầu sách &#x27;Cho Tôi Xin Một Vé Đi Tuổi Thơ&#x27; hiện vẫn còn 2 bản sao khả dụng tại thư viện. Bạn có thể mượn trực tiếp mà không cần đặt trước.</Data></Cell>
    <Cell ss:StyleID="sPass"><Data ss:Type="String">PASS</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">None</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đã nghiệm thu</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sDataCenter"><Data ss:Type="String">TC_RES_07</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đặt trước sách</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Sai dữ liệu</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Chặn độc giả đặt trước trùng lặp cùng một đầu sách</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">HTTP 400: &#x27;Bạn đã có một yêu cầu đặt trước đang hiệu lực&#x27;</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">HTTP 400: Bạn đã có một yêu cầu đặt trước đang hiệu lực cho cuốn &#x27;Clean Code: A Handbook of Agile Software Craftsmanship&#x27;.</Data></Cell>
    <Cell ss:StyleID="sPass"><Data ss:Type="String">PASS</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">None</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đã nghiệm thu</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sDataCenter"><Data ss:Type="String">TC_RES_08</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đặt trước sách</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Sai dữ liệu</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Chặn độc giả khi vượt quá hạn mức tối đa 3 đơn đặt trước cùng lúc</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">HTTP 400: &#x27;Mỗi độc giả chỉ được đặt trước tối đa 3 đầu sách cùng lúc&#x27;</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">HTTP 400: Mỗi độc giả chỉ được đặt trước tối đa 3 đầu sách cùng lúc. Vui lòng huỷ hoặc hoàn thành các lượt trước đó.</Data></Cell>
    <Cell ss:StyleID="sPass"><Data ss:Type="String">PASS</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">None</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đã nghiệm thu</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sDataCenter"><Data ss:Type="String">TC_RES_09</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đặt trước sách</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Sai dữ liệu</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Gửi mã ISBN không tồn tại trong hệ thống thư viện</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">HTTP 404: &#x27;Không tìm thấy đầu sách với mã ISBN yêu cầu&#x27;</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">HTTP 404: Không tìm thấy đầu sách với mã ISBN này</Data></Cell>
    <Cell ss:StyleID="sPass"><Data ss:Type="String">PASS</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">None</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đã nghiệm thu</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sDataCenter"><Data ss:Type="String">TC_TAX_04</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Quản lý Danh mục</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Sai dữ liệu</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Chặn thêm mới thể loại có tên trùng lặp (không phân biệt hoa/thường)</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">HTTP 400: &#x27;Thể loại đã tồn tại trong hệ thống&#x27;</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">HTTP 400: Thể loại &#x27;khoa học máy tính&#x27; đã tồn tại trong hệ thống. Vui lòng chọn tên khác.</Data></Cell>
    <Cell ss:StyleID="sPass"><Data ss:Type="String">PASS</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">None</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đã nghiệm thu</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sDataCenter"><Data ss:Type="String">TC_TAX_05</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Quản lý Danh mục</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Sai dữ liệu</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Chặn cập nhật đổi tên thể loại trùng với tên của thể loại khác</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">HTTP 400: &#x27;Tên thể loại đã tồn tại ở bản ghi khác&#x27;</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">HTTP 400: Tên thể loại &#x27;Khoa Học Máy Tính&#x27; đã tồn tại ở bản ghi khác. Vui lòng chọn tên khác.</Data></Cell>
    <Cell ss:StyleID="sPass"><Data ss:Type="String">PASS</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">None</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đã nghiệm thu</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sDataCenter"><Data ss:Type="String">TC_TAX_06</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Quản lý Danh mục</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Sai dữ liệu</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">CHẶN XOÁ THỂ LOẠI KHI CÒN ĐẦU SÁCH LIÊN KẾT (Báo lỗi số lượng rõ ràng)</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">HTTP 400: Không thể xoá vì còn đầu sách liên kết</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">HTTP 400: Không thể xoá thể loại &#x27;Khoa Học Máy Tính&#x27; vì vẫn còn 4 đầu sách đang thuộc thể loại này. Vui lòng chuyển các đầu sách sang thể loại khác trước khi xoá.</Data></Cell>
    <Cell ss:StyleID="sPass"><Data ss:Type="String">PASS</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">None</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đã nghiệm thu</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sDataCenter"><Data ss:Type="String">TC_TAX_07</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Quản lý Danh mục</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Sai dữ liệu</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">CHẶN XOÁ TÁC GIẢ KHI CÒN ĐẦU SÁCH LIÊN KẾT (Báo lỗi số lượng rõ ràng)</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">HTTP 400: Không thể xoá vì còn đầu sách liên kết tác giả đứng tên</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">HTTP 400: Không thể xoá tác giả &#x27;Robert C. Martin&#x27; vì vẫn còn 2 đầu sách liên kết tác giả này đứng tên. Vui lòng cập nhật lại thông tin sách trước khi xoá.</Data></Cell>
    <Cell ss:StyleID="sPass"><Data ss:Type="String">PASS</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">None</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Đã nghiệm thu</Data></Cell>
   </Row>
   <Row>
    <Cell ss:StyleID="sDataCenter"><Data ss:Type="String">TC_TAX_08</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Quản lý Danh mục</Data></Cell>
    <Cell ss:StyleID="sData"><Data ss:Type="String">Sai dữ liệu</Data></Cell>
